# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Config
.env
.env.local
.env.*.local

# SQLite temporary and lock files
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Storage exports, logs, and backups (keep directory structure with .gitkeep)
storage/exports/*
!storage/exports/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
